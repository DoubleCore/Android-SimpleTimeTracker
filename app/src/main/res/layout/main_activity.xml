<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button android:id="@+id/cloudSyncStatus" android:layout_width="match_parent"
        android:layout_height="48dp" android:text="云同步 · 连接设置" android:textAllCaps="false" />
    <Button android:id="@+id/aiAutoTags" android:layout_width="match_parent"
        android:layout_height="48dp" android:text="AI自动分类 · 购买的模型API" android:textAllCaps="false" />
    <Button android:id="@+id/lanDirect" android:layout_width="match_parent"
        android:layout_height="48dp" android:text="Wi-Fi直连手表（手机服务端）" android:textAllCaps="false" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <fragment
        android:id="@+id/container"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <FrameLayout
        android:id="@+id/mainProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_progress_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

    </FrameLayout>

</FrameLayout>
</LinearLayout>
